{
  "name": "simple",
  "description": "Simple single-message request without tools or system prompts - ideal for basic smoke tests",
  "defaults": {
    "turns": 1,
    "includeTools": false,
    "includeSystemPrompt": false,
    "temperature": 0.7,
    "maxTokens": 1000
  },
  "examples": [
    "dotnet run -- -p simple -m gpt-4o-mini-2024-07-18",
    "dotnet run -- -p simple --topic 'hello world' --language python"
  ]
}
