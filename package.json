{
	"name": "ai-hub-tools",
	"version": "1.0.0",
	"description": "AI Hub Performance Request Generator - generates realistic OpenAI-compatible JSON request payloads",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"ai-hub-generate": "dist/index.js"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
		"dev:api": "tsx watch src/api/server.ts",
		"build": "tsup src/index.ts src/api/server.ts --format esm --dts --clean",
		"start": "node dist/index.js",
		"start:api": "node dist/api/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src/",
		"lint:md": "markdownlint '**/*.md' --ignore node_modules",
		"lint:all": "npm run lint && npm run lint:md",
		"format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'public/**/*.{js,css,html}'",
		"format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'public/**/*.{js,css,html}'",
		"format:json": "prettier --write 'data/**/*.json'",
		"format:json:check": "prettier --check 'data/**/*.json'",
		"format:all": "npm run format && npm run format:json",
		"check": "npm run lint:all && npm run format:check && npm run format:json:check && npm test",
		"generate": "tsx src/index.ts"
	},
	"dependencies": {
		"clipboardy": "^4.0.0",
		"commander": "^12.1.0",
		"cors": "^2.8.5",
		"dotenv": "^17.3.1",
		"express": "^4.21.0",
		"jose": "^6.1.3"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.0.0",
		"markdownlint-cli": "^0.47.0",
		"prettier": "^3.8.1",
		"tsup": "^8.3.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"optionalDependencies": {
		"@rollup/rollup-darwin-arm64": "^4.57.1"
	}
}
